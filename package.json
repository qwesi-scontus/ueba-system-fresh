{
  "name": "ueba-system",
  "version": "1.0.0",
  "description": "User and Entity Behavior Analytics System",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:setup": "ts-node scripts/setupDatabase.ts",
    "db:seed": "ts-node scripts/seedData.ts",
    "db:reset": "ts-node scripts/resetDatabase.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "pg": "^8.11.2",
    "sequelize": "^6.35.0",
    "winston": "^3.11.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.10",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1"
  }
